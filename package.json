{
  "name": "pullup",
  "private": true,
  "version": "0.1.0",
  "description": "PullUp: a CI decision agent. After CI finishes it fails real breakage, passes routine changes, and asks its AskWithAI decision runtime (and a person when it matters) about the rest.",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "worker": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "pnpm -r test && vitest run",
    "test:e2e": "playwright test",
    "generate-data": "tsx scripts/generate-data.ts",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo.ts",
    "demo:compare": "tsx --env-file-if-exists=.env.local scripts/demo-compare.ts",
    "parity": "tsx --env-file-if-exists=.env.local scripts/parity.ts",
    "askwithai:sync": "sh scripts/askwithai-sync.sh",
    "demo:evidence": "tsx --env-file-if-exists=.env.local scripts/demo-evidence.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@askwithai/react": "file:vendor/askwithai-react-0.1.0.tgz",
    "@askwithai/sdk": "^0.1.0",
    "@parcha/agentrun-dsl": "0.1.0-beta.41",
    "@astryxdesign/charts": "0.7.15-canary.gf890983",
    "@astryxdesign/core": "0.7.14",
    "@astryxdesign/lab": "0.7.15-canary.gf890983",
    "@libsql/client": "^0.17.3",
    "@pullup/engine": "workspace:*",
    "@pullup/github": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "ai": "^7.0.138",
    "astryx-themes": "github:jaytoday/astryx-themes#b8667cb",
    "better-auth": "^1.6.18",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
