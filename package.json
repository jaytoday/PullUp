{
  "name": "pullup",
  "private": true,
  "version": "0.1.0",
  "description": "PullUp: a CI check that fails hard failures, passes when nothing is tricky, and asks a WithAI council (then a person) about the rest.",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "pullup": "tsx --env-file-if-exists=.env cli/pullup.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit",
    "test": "pnpm -r test && vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-dev.ts"
  },
  "bin": {
    "pullup": "cli/pullup.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@pullup/engine": "workspace:*",
    "@pullup/extensions": "workspace:^",
    "@pullup/github": "workspace:*",
    "@pullup/sdk": "workspace:^",
    "@askwithai/client": "workspace:*",
    "@withai/client": "workspace:*",
    "better-auth": "^1.6.18",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "motion": "^14.9.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "1.54.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
