# Copy to .env.local (git-ignored). Never commit keys.

# Sign-in (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3500
# Set to 1 to let more people sign up after the first (owner) account.
# PULLUP_OPEN_SIGNUP=1

# PullUp's own address, for links in check runs.
PULLUP_URL=http://localhost:3500
# Signs the single-use permits every GitHub call needs. Without it nothing is posted. openssl rand -hex 32
PULLUP_PERMIT_KEY=
# The stop switch from the environment: 1 means nothing is posted to GitHub.
# PULLUP_STOP=1

# Demo mode: synthetic pull requests on a fake GitHub (no GitHub App needed).
# PULLUP_DEMO=1

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App's private key; escaped newlines (\n) are fine.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Which decision provider answers the agent's `assess` tool: jev, gemini or askwithai.
PULLUP_DECIDER=jev
# Jev (System One). Adoption step 1 points the base address at the AskWithAI runtime:
#   JEV_BASE_URL=http://localhost:3700/v1/runtimes/<owner>/ci-review   JEV_API_KEY=wai_...
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
# JEV_MODEL=jev-1.13.0
# Gemini Decisions API (the other baseline).
# GEMINI_DECISIONS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=
# AskWithAI (PULLUP_DECIDER=askwithai, and the web kit screens).
ASKWITHAI_URL=http://localhost:3700
ASKWITHAI_API_KEY=
PULLUP_RUNTIME=
# How long `assess` waits for a decision before going on (milliseconds).
# PULLUP_DECIDE_WAIT_MS=5000

# The agent. Without ANTHROPIC_API_KEY (or with PULLUP_DEMO=1) a scripted planner drives the tools, with no model.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-haiku-4-5
# AGENT_HARNESS=ai-sdk   (or claude-agent)

# Database: a local file in .data/ unless these are set (Turso, hosted SQLite).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Run the worker as its own process (pnpm worker) instead of inside the web server.
# PULLUP_SEPARATE_WORKER=1
