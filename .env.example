# Sign-in (Better Auth). Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3500
# Set to 1 to let more people sign up after the first (owner) account.
# PULLUP_OPEN_SIGNUP=1

# PullUp's own address, for links in check runs and the WithAI webhook.
PULLUP_URL=http://localhost:3500
# Signs the single-use permits every GitHub call needs. Without it nothing is posted. openssl rand -hex 32
PULLUP_PERMIT_KEY=
# The stop switch from the environment: 1 means nothing is posted to GitHub.
# PULLUP_STOP=1

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App's private key; escaped newlines (\n) are fine.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# For local runs without an App, a personal token can read (it cannot post check runs).
# GITHUB_TOKEN=

# AskWithAI Decision API. Configure and pin immutable runtime versions with fixed labels:
# pass/fail/needs_person for review and option_1..option_8 for extension screens.
ASKWITHAI_URL=
ASKWITHAI_API_KEY=
PULLUP_ASKWITHAI_MODE=shadow
PULLUP_REVIEW_RUNTIME=
PULLUP_REVIEW_VERSION=
PULLUP_REVIEW_ANSWER_KEY=
PULLUP_SCREEN_RUNTIME=
PULLUP_SCREEN_VERSION=
PULLUP_SCREEN_ANSWER_KEY=

# Legacy WithAI person notifications remain during the migration. PullUp no longer
# uses this integration to make review or extension-screen decisions.
# The token needs: questions:read, questions:write.
WITHAI_URL=
WITHAI_TOKEN=
WITHAI_WEBHOOK_SECRET=
# Existing notification skill; remove after the legacy notification path is migrated.
# PULLUP_SKILL_ID=

# Database: a local file in .data/ unless these are set (Turso, hosted SQLite).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Run the worker as its own process (pnpm worker) instead of inside the web server.
# PULLUP_SEPARATE_WORKER=1
