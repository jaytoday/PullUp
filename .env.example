# PullUp — environment
# The CLI analytics path runs fully offline on synthetic fixtures by default.
# Live GitHub ingestion needs a GitHub App; the bot needs the webhook secret.
#
# GitHub App (CLI ingestion + bot)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional pre-resolved installation token (skips App JWT minting)
# GITHUB_INSTALLATION_TOKEN=

# Live review writes (docs/github.md, docs/authority.md). Off unless "live".
# PULLUP_GITHUB_DELIVERY=live
# Signs per-action permits; required for live writes (openssl rand -hex 32).
# PULLUP_PERMIT_KEY=

# Agent model (the bot's root agent). Direct Anthropic call.
ANTHROPIC_API_KEY=
PULLUP_MODEL=claude-sonnet-4-6

# Storage: where PullUp keeps ingested PR history.
# PULLUP_DB=file:.pullup/pullup.db

# Jev risk layer (optional). With a key, signal runs call TypeSafe's Jev API —
# diff hunks leave your machine (ZDR is enterprise-only). Without one, PullUp
# uses a deterministic synthetic stand-in and says so in every report.
# TYPESAFE_API_KEY=
# Force a signal model: jev | systemone | synthetic | replay
# PULLUP_SIGNAL_MODEL=
# Any System One server instead of TypeSafe (Ollama, llama.cpp, OpenCode Zen):
# hunks are sent only there. Operator setting; repo settings can't change it.
# PULLUP_SYSTEMONE_URL=http://localhost:11434
# PULLUP_SYSTEMONE_MODEL=jev-1.13
# PULLUP_SYSTEMONE_API_KEY=
# How units are sent: text (default, what Gallant sends) | object (TypeSafe's shape)
# PULLUP_SYSTEMONE_STATE=
# Replay file for PULLUP_SIGNAL_MODEL=replay (record: pullup signals --record)
# PULLUP_REPLAY_PATH=
