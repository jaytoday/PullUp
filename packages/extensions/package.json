{
  "name": "@pullup/extensions",
  "version": "0.1.0",
  "private": true,
  "description": "PullUp's bundled extensions, one folder each. Each imports only @pullup/sdk, zod and its own files.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pullup/sdk": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
