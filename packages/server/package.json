{
  "name": "@pullup/server",
  "version": "0.1.0",
  "description": "PullUp local JSON API for the web dashboard: reports, PR triage detail, logged review actions, calibration — thin over @pullup/core, @pullup/db, @pullup/jev.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@pullup/core": "workspace:*",
    "@pullup/db": "workspace:*",
    "@pullup/github": "workspace:*",
    "@pullup/jev": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
